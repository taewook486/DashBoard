# DashBoard Environment Configuration
# Copy this file to .env and fill in your values
# @SPEC:IMPROVE-001

# ===========================================
# API Keys (Required for AI features)
# ===========================================

# Google Gemini API Key for AI Analysis
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key for GPT Analysis
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# FRED API Key (Optional - for additional economic data)
# Get your API key from: https://fred.stlouisfed.org/docs/api/api_key
FRED_API_KEY=your_fred_api_key_here

# ===========================================
# Flask Configuration
# ===========================================
FLASK_APP=flask_app
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Server Configuration
HOST=0.0.0.0
PORT=5001

# ===========================================
# Logging Configuration
# @SPEC:IMPROVE-001 REQ-LOG-001
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===========================================
# Security Configuration
# @SPEC:IMPROVE-001 REQ-SEC-003, REQ-SEC-004
# ===========================================

# CORS Configuration
CORS_ENABLED=true
ALLOWED_ORIGINS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100 per minute

# ===========================================
# Cache Configuration
# @SPEC:IMPROVE-001 REQ-PERF-002
# ===========================================
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# ===========================================
# Data Configuration
# ===========================================
DATA_DIR=./us_market/data

# ===========================================
# Application Metadata
# ===========================================
VERSION=1.0.0
APP_NAME=DashBoard

# ===========================================
# Render-specific (Deployment)
# ===========================================
PYTHON_VERSION=3.11.0
RENDER_PORT=5001

# ===========================================
# Security Notes
# ===========================================
# - NEVER commit actual API keys to Git
# - Use environment variables in production
# - Keep this file as a template for API key placeholders
# - Generate a strong SECRET_KEY for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
